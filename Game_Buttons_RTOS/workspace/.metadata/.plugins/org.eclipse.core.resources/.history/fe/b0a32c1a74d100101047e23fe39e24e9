	setColor(0, 0, 0);
	fillRect(30, 100, 210, 220);

	setFont(BigFont);
	setColor(255, 0, 0);
	lcdPrint("GAME OVER", 40, 110);

	setFont(SmallFont);
	setColor(255, 255, 255);
	lcdPrint("Distance:", 70, 150);

	char buf[16];
	snprintf(buf, sizeof(buf), "%d", distance);
	lcdPrint(buf, 90, 175);

	setColor(0, 255, 0);
	lcdPrint("Click to restart", 30, 200);
}

