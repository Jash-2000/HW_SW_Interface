}

void rotatePlayerClockwise(void) {
    player.angle += ROTATION_SPEED;
    // Normalize angle to -PI to PI range
    while (player.angle > PI) player.angle -= 2.0f * PI;
}

void rotatePlayerAntiClockwise(void) {
    player.angle -= ROTATION_SPEED;
    // Normalize angle to -PI to PI range
    while (player.angle < -PI) player.angle += 2.0f * PI;
}

void updatePlayer(void) {
    // Calculate velocity based on current angle
    float dx = player.speed * cosf(player.angle);
    float dy = player.speed * sinf(player.angle);

    float newX = player.x + dx;
    float newY = player.y + dy;

    // Boundary checking
    if (newX - PLAYER_SIZE/2 >= FIELD_LEFT && newX + PLAYER_SIZE/2 <= FIELD_RIGHT) {
        player.x = newX;
    }
    if (newY - PLAYER_SIZE/2 >= FIELD_TOP && newY + PLAYER_SIZE/2 <= FIELD_BOTTOM) {
        player.y = newY;
    }
}

void checkBallPlayerCollision(void) {
    float dx = ball.x - player.x;
    float dy = ball.y - player.y;
    float dist = sqrtf(dx*dx + dy*dy);

    if (dist < PLAYER_SIZE/2 + BALL_RADIUS) {
        // Collision detected - push ball away
        float angle = atan2f(dy, dx);
        ball.vx += PLAYER_PUSH_STRENGTH * cosf(angle);
        ball.vy += PLAYER_PUSH_STRENGTH * sinf(angle);

        // Separate ball from player
        float overlap = (PLAYER_SIZE/2 + BALL_RADIUS) - dist;
        ball.x += overlap * cosf(angle);
        ball.y += overlap * sinf(angle);
    }
}

void checkBallWallCollision(void) {
    // Field boundaries
    if (ball.x - BALL_RADIUS <= FIELD_LEFT) {
        ball.x = FIELD_LEFT + BALL_RADIUS;
        ball.vx = -ball.vx * BALL_BOUNCE;
    }
    if (ball.x + BALL_RADIUS >= FIELD_RIGHT) {
        ball.x = FIELD_RIGHT - BALL_RADIUS;
        ball.vx = -ball.vx * BALL_BOUNCE;
    }
    if (ball.y - BALL_RADIUS <= FIELD_TOP) {
        ball.y = FIELD_TOP + BALL_RADIUS;
        ball.vy = -ball.vy * BALL_BOUNCE;
    }
    if (ball.y + BALL_RADIUS >= FIELD_BOTTOM) {
        ball.y = FIELD_BOTTOM - BALL_RADIUS;
        ball.vy = -ball.vy * BALL_BOUNCE;
    }

    // Central walls
    for (int i = 0; i < NUM_WALLS; i++) {
        Wall* w = &walls[i];
        if (ball.x + BALL_RADIUS > w->x1 && ball.x - BALL_RADIUS < w->x2 &&
            ball.y + BALL_RADIUS > w->y1 && ball.y - BALL_RADIUS < w->y2) {

            // Simple bounce (determine which side)
            float centerX = (w->x1 + w->x2) / 2.0f;
            float centerY = (w->y1 + w->y2) / 2.0f;

            if (abs(ball.x - centerX) > abs(ball.y - centerY)) {
                ball.vx = -ball.vx * BALL_BOUNCE;
            } else {
                ball.vy = -ball.vy * BALL_BOUNCE;
            }
        }
    }
}

int checkGoalScored(void) {
    // Top goal
    if (ball.y - BALL_RADIUS <= TOP_GOAL_Y + GOAL_HEIGHT &&
        ball.x >= TOP_GOAL_X && ball.x <= TOP_GOAL_X + GOAL_WIDTH) {
        score_top++;
        return 1;
    }

    // Bottom goal
    if (ball.y + BALL_RADIUS >= BOTTOM_GOAL_Y &&
        ball.x >= BOTTOM_GOAL_X && ball.x <= BOTTOM_GOAL_X + GOAL_WIDTH) {
        score_bottom++;
        return 2;
    }

    return 0;
}

void resetBall(void) {
    ball.x = INITIAL_BALL_X;
    ball.y = INITIAL_BALL_Y;
    ball.vx = 0;
    ball.vy = 0;
}

void updateBall(void) {
    // Apply friction
    ball.vx *= FRICTION;
    ball.vy *= FRICTION;

    // Update position
    ball.x += ball.vx;
    ball.y += ball.vy;

    // Stop if moving very slowly
    if (abs(ball.vx) < 0.1f) ball.vx = 0;
    if (abs(ball.vy) < 0.1f) ball.vy = 0;

    checkBallWallCollision();
}

// Simple math approximations
float sqrtf(float x) {
    if (x <= 0) return 0;
    float guess = x / 2.0f;
    for (int i = 0; i < 10; i++) {
        guess = (guess + x / guess) / 2.0f;
    }
    return guess;
}

float atan2f(float y, float x) {
    float ax = abs(x), ay = abs(y);
    float a = (ax < ay) ? ax / ay : ay / ax;
    float s = a * a;
    float r = ((-0.0464964749f * s + 0.15931422f) * s - 0.327622764f) * s * a + a;
    if (ay > ax) r = 1.57079637f - r;
    if (x < 0) r = 3.14159274f - r;
    if (y < 0) r = -r;
    return r;
}

float cosf(float x) {
    // Normalize to 0-2PI range
    while (x < 0) x += 2.0f * PI;
    while (x >= 2.0f * PI) x -= 2.0f * PI;

    x = x / (2.0f * PI); // Normalize to 0-1

    // Use polynomial approximation
    float x2 = x * x;
    if (x < 0.25f) {
        return 1.0f - 4.0f * PI * PI * x2 / 2.0f;
    } else if (x < 0.75f) {
        float t = x - 0.5f;
        return -1.0f + 4.0f * PI * PI * t * t / 2.0f;
    } else {
        float t = x - 1.0f;
        return 1.0f - 4.0f * PI * PI * t * t / 2.0f;
    }
}

float sinf(float x) {
    return cosf(x - PI / 2.0f);
}
