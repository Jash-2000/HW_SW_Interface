// Draw obstacle
void drawObstacle(Obstacle *obs) {
    if (!obs->active) return;

    if (obs->type == OBS_GROUND) {
        // Cactus-like obstacle
        setColor(34, 139, 34);
        fillRect(obs->x, obs->y, obs->x + obs->width, obs->y + obs->height);
        setColor(0, 100, 0);
        fillRect(obs->x + 2, obs->y + 5, obs->x + obs->width - 2, obs->y + obs->height - 3);
    } else {
        // Flying obstacle (bird)
        setColor(100, 100, 100);
        fillRect(obs->x, obs->y, obs->x + obs->width, obs->y + obs->height);
        setColor(80, 80, 80);
        fillRect(obs->x + 3, obs->y + 2, obs->x + obs->width - 3, obs->y + obs->height - 2);
    }
}
