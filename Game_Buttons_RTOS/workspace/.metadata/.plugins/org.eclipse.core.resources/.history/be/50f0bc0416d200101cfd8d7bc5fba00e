// Convert counter to 8 display digits (SSSS.ffff) 
void updateDigits() { 
    int t = counter; 
    if (t < 0) t = 0; 
 
    int secs = t / 1000;   // whole seconds 
    int frac = t % 1000;   // 
 
    digits[3] = secs % 10; secs /= 10; 
    digits[2] = secs % 10; secs /= 10; 
    digits[1] = secs % 10; secs /= 10; 
    digits[0] = secs % 10; 
 
    digits[7] = 0; //frac%10; frac/=10; 
    digits[6] = frac%10; frac/=10; 
    digits[5] = frac%10; frac/=10; 
    digits[4] = frac%10; 
} 
 
 
void ButtonsHandler(void *CallbackRef) { 
	interrupt_arrived_flag = 1; 
    // Latch & clear interrupt 
	u32 status = XGpio_InterruptGetStatus(&btnGpio); 
    XGpio_InterruptClear(&btnGpio, status); 
    int btns = XGpio_DiscreteRead(&btnGpio, 1); 
 
    // 1 for North 2 for East 3 for South 4 for South 
    if (btns & 0x01) { buttonPressed = 1; } 
    else if (btns & 0x02) { buttonPressed = 2; } 
    else if (btns & 0x04) { buttonPressed = 3; } 
    else if (btns & 0x08) { buttonPressed = 4; } 
 
    QActive_postISR((QActive *)&AO_Game, BUTTON); 
} 
void EncoderHandler(void *CallbackRef) 
{ 
    interrupt_arrived_flag = 1; 
	(void)CallbackRef; 
    uint32_t v  = XGpio_DiscreteRead(&encGpio, ENC_GPIO_CHANNEL); 
    uint8_t ab  = (ENC_A(v) << 1) | ENC_B(v); 
    uint8_t p   = ENC_P(v); 
 
    encoder_quad_step(&enc, ab);      // debounce 
    encoder_push_update(&enc, p);     // sets push_rise/push_fall flags (raw) 
 
    // clear source (level-sensitive) 
    XGpio_InterruptClear(&encGpio, ENC_GPIO_CHANNEL); 
 
    if(enc.push_rise){ 
    	enc.push_rise = false; 
    	QActive_postISR((QActive *)&AO_Game, ENCODER_CLICK); 
    } 
    if (enc.step_right){ 
    	enc.step_right = false; 
    	encoder_twist = 0; 
    	QActive_postISR((QActive *)&AO_Game, ENCODER_TWIST); 
    } 
    if (enc.step_left){ 
    	enc.step_left  = false; 
    	encoder_twist = 1; 
    	QActive_postISR((QActive *)&AO_Game, ENCODER_TWIST); 
    } 
 
} 
 
void TimerCounterHandler(void *CallBackRef, u8 TmrCtrNumber) 
{ 
	interrupt_arrived_flag = 1; 
	custom_tick += 1; 
	if(custom_tick == 3000){	// Used to Reset the Text in 3 seconds 
		QActive_postISR((QActive *)&AO_Game, CUSTOM_TIMEOUT); 
	} 
 
    if (running==1) { 
    	updateDigits(); 
    	counter += 1; 
    	if(custom_tick%speed == 0) 
    	{ 
    		QActive_postISR((QActive *)&AO_Game, GAME_TICK); 
    	} 
    }else if(running == 2){counter = 0; updateDigits();} 
 
} 
 
void BSP_init(void) { 
    u32 controlReg; 
    XSpi_Config *spiConfig; // Pointer to Configuration data 
 
    // Initialization Phase to setup the interrupts 
    XIntc_Initialize(&intc, INTC_DEVICE_ID); 
    XTmrCtr_Initialize(&axiTimer, TIMER_DEVICE_ID); 
    XGpio_Initialize(&btnGpio, BTN_GPIO_DEVICE_ID); 
    XGpio_Initialize(&encGpio, ENC_GPIO_DEVICE_ID); 
 
    // Connect Phase to connect the peripherals to Int Controller bus 
    XIntc_Connect(&intc, TIMER_IRPT_ID, (XInterruptHandler)XTmrCtr_InterruptHandler, (void *)&axiTimer); 
    XTmrCtr_SetHandler(&axiTimer, TimerCounterHandler, &axiTimer); 
    XIntc_Connect(&intc, BTN_GPIO_IRQ_ID, (XInterruptHandler)ButtonsHandler, (void *)&btnGpio); 
    XIntc_Connect(&intc, ENC_GPIO_IRQ_ID, (XInterruptHandler)EncoderHandler, (void *)&encGpio); 
 
    // Start and Enable Phase 
    XIntc_Start(&intc, XIN_REAL_MODE); 
    XIntc_Enable(&intc, TIMER_IRPT_ID); 
    XIntc_Enable(&intc, BTN_GPIO_IRQ_ID); 
    XIntc_Enable(&intc, ENC_GPIO_IRQ_ID); 
 
    // Configuration Phase for all the Peripherals 
    	// BTNS Config 
    XGpio_SetDataDirection(&btnGpio, BTN_GPIO_CHANNEL, 0xFFFFFFFF); // inputs 
    XGpio_InterruptGlobalEnable(&btnGpio); 
    XGpio_InterruptEnable(&btnGpio, 0xFFFF); 
 
    	// Encoder Config 
    XGpio_SetDataDirection(&encGpio, ENC_GPIO_CHANNEL, 0xFFFFFFFF); // inputs 
    XGpio_InterruptDisable(&encGpio, ENC_GPIO_CHANNEL); 
    XGpio_InterruptClear(&encGpio,  ENC_GPIO_CHANNEL); 
    XGpio_InterruptEnable(&encGpio,  ENC_GPIO_CHANNEL); 
    XGpio_InterruptGlobalEnable(&encGpio); 
 
       // Timer Config 
    XTmrCtr_SetOptions(&axiTimer, 0, XTC_INT_MODE_OPTION | XTC_AUTO_RELOAD_OPTION); 
    XTmrCtr_SetResetValue(&axiTimer, 0,0xFFFFFFFF - RESET_VALUE); 
    XTmrCtr_Start(&axiTimer, 0); 
 
    // MicroBlaze Interrupt Registration 
    Xil_ExceptionInit(); 
    Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT, (Xil_ExceptionHandler)XIntc_InterruptHandler, &intc); 
    Xil_ExceptionEnable(); 
    microblaze_enable_interrupts(); 
 
    // SPI DC Setup for LCD Screen 
    XGpio_Initialize(&dc, XPAR_SPI_DC_DEVICE_ID); 
    XGpio_SetDataDirection(&dc, 1, 0x0); 
    spiConfig = XSpi_LookupConfig(XPAR_SPI_DEVICE_ID); 
    XSpi_CfgInitialize(&spi, spiConfig, spiConfig->BaseAddress); 
    XSpi_Reset(&spi); 
    controlReg = XSpi_GetControlReg(&spi); 
    XSpi_SetControlReg(&spi, 
        (controlReg | XSP_CR_ENABLE_MASK | XSP_CR_MASTER_MODE_MASK) & (~XSP_CR_TRANS_INHIBIT_MASK)); 
    XSpi_SetSlaveSelectReg(&spi, ~0x01); 
#if TESTING_MODE
    wake_word_init();
#endif
#if TRAINING_MODE
    // ===== TRAINING MODE =====
    training_mode(&timer);
#endif

} 
 
