/*****************************************************************************
    Dino Runner - LCD Graphics Module
    Modified for endless runner game mechanics
*****************************************************************************/
#include "lcd.h"

// Global variables
int fch, fcl, bch, bcl;
struct _current_font cfont;

// Game state
DinoPlayer dino = {30, 200, 0, 0, 0};  // x, y, jumping, ducking, jumpVelocity
Obstacle obstacles[MAX_OBSTACLES];
int score = 0;
int gameSpeed = 4;

// LCD Write Functions
void LCD_Write_COM(char VL) {
    Xil_Out32(SPI_DC, 0x0);
    Xil_Out32(SPI_DTR, VL);
    while (0 == (Xil_In32(SPI_IISR) & XSP_INTR_TX_EMPTY_MASK));
    Xil_Out32(SPI_IISR, Xil_In32(SPI_IISR) | XSP_INTR_TX_EMPTY_MASK);
}

void LCD_Write_DATA(char VL) {
    Xil_Out32(SPI_DC, 0x01);
    Xil_Out32(SPI_DTR, VL);
    while (0 == (Xil_In32(SPI_IISR) & XSP_INTR_TX_EMPTY_MASK));
    Xil_Out32(SPI_IISR, Xil_In32(SPI_IISR) | XSP_INTR_TX_EMPTY_MASK);
}

void initLCD(void) {
    int i;
    LCD_Write_COM(0x01);
    for (i = 0; i < 500000; i++);

    LCD_Write_COM(0xCB);
    LCD_Write_DATA(0x39); LCD_Write_DATA(0x2C); LCD_Write_DATA(0x00);
    LCD_Write_DATA(0x34); LCD_Write_DATA(0x02);

    LCD_Write_COM(0xCF);
    LCD_Write_DATA(0x00); LCD_Write_DATA(0XC1); LCD_Write_DATA(0X30);

    LCD_Write_COM(0xE8);
    LCD_Write_DATA(0x85); LCD_Write_DATA(0x00); LCD_Write_DATA(0x78);

    LCD_Write_COM(0xEA);
    LCD_Write_DATA(0x00); LCD_Write_DATA(0x00);

    LCD_Write_COM(0xED);
    LCD_Write_DATA(0x64); LCD_Write_DATA(0x03);
    LCD_Write_DATA(0X12); LCD_Write_DATA(0X81);

    LCD_Write_COM(0xF7); LCD_Write_DATA(0x20);
    LCD_Write_COM(0xC0); LCD_Write_DATA(0x23);
    LCD_Write_COM(0xC1); LCD_Write_DATA(0x10);
    LCD_Write_COM(0xC5); LCD_Write_DATA(0x3e); LCD_Write_DATA(0x28);
    LCD_Write_COM(0xC7); LCD_Write_DATA(0x86);
    LCD_Write_COM(0x36); LCD_Write_DATA(0x48);
    LCD_Write_COM(0x3A); LCD_Write_DATA(0x55);
    LCD_Write_COM(0xB1); LCD_Write_DATA(0x00); LCD_Write_DATA(0x18);
    LCD_Write_COM(0xB6);
    LCD_Write_DATA(0x08); LCD_Write_DATA(0x82); LCD_Write_DATA(0x27);
    LCD_Write_COM(0x11);
    for (i = 0; i < 100000; i++);
    LCD_Write_COM(0x29);
    LCD_Write_COM(0x2c);

    fch = 0xFF; fcl = 0xFF;
    bch = 0x00; bcl = 0x00;
    setFont(SmallFont);
}

void setXY(int x1, int y1, int x2, int y2) {
    LCD_Write_COM(0x2A);
    LCD_Write_DATA(x1 >> 8); LCD_Write_DATA(x1);
    LCD_Write_DATA(x2 >> 8); LCD_Write_DATA(x2);
    LCD_Write_COM(0x2B);
    LCD_Write_DATA(y1 >> 8); LCD_Write_DATA(y1);
    LCD_Write_DATA(y2 >> 8); LCD_Write_DATA(y2);
    LCD_Write_COM(0x2C);
}

void clrXY(void) {
    setXY(0, 0, DISP_X_SIZE, DISP_Y_SIZE);
}

void setColor(u8 r, u8 g, u8 b) {
    fch = (r & 0x0F8) | g >> 5;
    fcl = (g & 0x1C) << 3 | b >> 3;
}

void setColorBg(u8 r, u8 g, u8 b) {
    bch = (r & 0x0F8) | g >> 5;
    bcl = (g & 0x1C) << 3 | b >> 3;
}

void clrScr(void) {
    setColor(0, 0, 0);
    fillRect(0, 0, DISP_X_SIZE, DISP_Y_SIZE);
}

void drawVLine(int x, int y, int l) {
    if (l < 0) { l = -l; y -= l; }
    setXY(x, y, x, y + l);
    for (int i = 0; i < l + 1; i++) {
        LCD_Write_DATA(fch); LCD_Write_DATA(fcl);
    }
    clrXY();
}

void drawHLine(int x, int y, int l) {
    if (l < 0) { l = -l; x -= l; }
    setXY(x, y, x + l, y);
    for (int i = 0; i < l + 1; i++) {
        LCD_Write_DATA(fch); LCD_Write_DATA(fcl);
    }
    clrXY();
}

void fillRect(int x1, int y1, int x2, int y2) {
    if (x1 > x2) swap(int, x1, x2);
    if (y1 > y2) swap(int, y1, y2);
    setXY(x1, y1, x2, y2);
    for (int i = 0; i < (x2 - x1 + 1) * (y2 - y1 + 1); i++) {
        LCD_Write_DATA(fch); LCD_Write_DATA(fcl);
    }
    clrXY();
}

void setFont(u8* font) {
    cfont.font = font;
    cfont.x_size = font[0];
    cfont.y_size = font[1];
    cfont.offset = font[2];
    cfont.numchars = font[3];
}

void printChar(u8 c, int x, int y) {
    u8 ch;
    setXY(x, y, x + cfont.x_size - 1, y + cfont.y_size - 1);
    int pixelIndex = (c - cfont.offset) * (cfont.x_size >> 3) * cfont.y_size + 4;
    for (int j = 0; j < (cfont.x_size >> 3) * cfont.y_size; j++) {
        ch = cfont.font[pixelIndex];
        for (int i = 0; i < 8; i++) {
            if ((ch & (1 << (7 - i))) != 0) {
                LCD_Write_DATA(fch); LCD_Write_DATA(fcl);
            } else {
                LCD_Write_DATA(bch); LCD_Write_DATA(bcl);
            }
        }
        pixelIndex++;
    }
    clrXY();
}

void lcdPrint(char *st, int x, int y) {
    int i = 0;
    while (*st != '\0')
        printChar(*st++, x + cfont.x_size * i++, y);
}

// Draw the ground line
void drawGround(void) {
    setColor(150, 150, 150);
    fillRect(0, GROUND_Y, 239, GROUND_Y + 2);
}

// Draw dino (simple rectangle representation)
void drawDino(void) {
    if (dino.ducking) {
        // Ducking dino - shorter and wider
        setColor(50, 200, 50);
        fillRect(dino.x, dino.y + 10, dino.x + 25, dino.y + 25);
        setColor(255, 255, 255);
        fillRect(dino.x + 3, dino.y + 13, dino.x + 6, dino.y + 16); // Eye
    } else {
        // Standing/jumping dino
        setColor(50, 200, 50);
        // Body
        fillRect(dino.x, dino.y, dino.x + 20, dino.y + 25);
        // Head
        fillRect(dino.x + 5, dino.y - 8, dino.x + 20, dino.y + 5);
        // Eye
        setColor(255, 255, 255);
        fillRect(dino.x + 8, dino.y - 5, dino.x + 11, dino.y - 2);
        // Legs
        setColor(50, 200, 50);
        fillRect(dino.x + 2, dino.y + 25, dino.x + 7, dino.y + 30);
        fillRect(dino.x + 13, dino.y + 25, dino.x + 18, dino.y + 30);
    }
}

// Clear dino at old position
void clearDino(int oldY, int wasDucking) {
    setColor(135, 206, 235); // Sky blue
    if (wasDucking) {
        fillRect(dino.x, oldY + 10, dino.x + 25, oldY + 35);
    } else {
        fillRect(dino.x, oldY - 8, dino.x + 20, oldY + 30);
    }
}

// Draw obstacle
void drawObstacle(Obstacle *obs) {
    if (!obs->active) return;

    if (obs->type == OBS_GROUND) {
        // Cactus-like obstacle
        setColor(34, 139, 34);
        fillRect(obs->x, obs->y, obs->x + obs->width, obs->y + obs->height);
        setColor(0, 100, 0);
        fillRect(obs->x + 2, obs->y + 5, obs->x + obs->width - 2, obs->y + obs->height - 3);
    } else {
        // Flying obstacle (bird)
        setColor(100, 100, 100);
        fillRect(obs->x, obs->y, obs->x + obs->width, obs->y + obs->height);
        setColor(80, 80, 80);
        fillRect(obs->x + 3, obs->y + 2, obs->x + obs->width - 3, obs->y + obs->height - 2);
    }
}

// Clear obstacle at position
void clearObstacle(Obstacle *obs) {
    setColor(135, 206, 235); // Sky blue
    fillRect(obs->x, obs->y, obs->x + obs->width, obs->y + obs->height);
}

// Initialize game screen
void initGameScreen(void) {
    clrScr();
    setColor(135, 206, 235); // Sky blue background
    fillRect(0, 0, 239, 319);
    drawGround();

    // Initialize obstacles
    for (int i = 0; i < MAX_OBSTACLES; i++) {
        obstacles[i].active = 0;
    }

    score = 0;
    gameSpeed = 4;
}

// Draw menu screen
void drawMenuScreen(void) {
    clrScr();
    setColor(135, 206, 235);
    fillRect(0, 0, 239, 319);

    setFont(BigFont);
    setColor(50, 200, 50);
    lcdPrint("DINO RUNNER", 30, 80);

    setFont(SmallFont);
    setColor(0, 0, 0);
    lcdPrint("BTN1: JUMP", 50, 140);
    lcdPrint("BTN2: DUCK", 50, 160);
    lcdPrint("CLICK: START", 40, 200);
    lcdPrint("Press to Begin!", 30, 240);
}

// Draw game over screen
void drawGameOver(int finalScore) {
    setColor(255, 0, 0);
    fillRect(40, 100, 200, 180);

    setFont(BigFont);
    setColor(255, 255, 255);
    lcdPrint("GAME OVER", 45, 110);

    setFont(SmallFont);
    char buf[20];
    snprintf(buf, sizeof(buf), "Score: %d", finalScore);
    lcdPrint(buf, 70, 145);

    lcdPrint("CLICK to Restart", 30, 220);
}

// Update score display
void updateScore(void) {
    setColor(135, 206, 235);
    fillRect(150, 10, 230, 30);

    setFont(SmallFont);
    setColor(0, 0, 0);
    char buf[15];
    snprintf(buf, sizeof(buf), "Score:%d", score);
    lcdPrint(buf, 155, 15);
}
