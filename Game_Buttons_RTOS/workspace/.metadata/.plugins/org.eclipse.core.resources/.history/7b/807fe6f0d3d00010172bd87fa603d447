typedef struct Lab2ATag  {               //Lab2A State machine
	QActive super;
}  Lab2A;

/* Setup state machines */
/**********************************************************************/
static QState Lab2A_initial (Lab2A *me);
static QState Level_Select      (Lab2A *me);
static QState Pause  (Lab2A *me);
static QState Running  (Lab2A *me);
static QState Result  (Lab2A *me);

Lab2A AO_Lab2A;

volatile int custom_tick = 0;
volatile int buttonPressed = 0;
volatile int running   = 0;     // stopwatch running flag
volatile int counter   = 0;     // stopwatch counter
volatile int encoder_twist = 0;	// +1 for ACW and 0 for CW
int lvl_no = 0;		// Flag to choose the level number
int game_win = 0;	// Flag to see if the player won or not
char buf[12];            // enough for "Level " + number
int trials = 0;

void Lab2A_ctor(void)  {
	Lab2A *me = &AO_Lab2A;
	QActive_ctor(&me->super, (QStateHandler)&Lab2A_initial);
}


QState Lab2A_initial(Lab2A *me) {
    initLCD();
    drawScene();
    counter = 0;
    running = 0;
	lvl_no = 0;
	return Q_TRAN(&Level_Select);
}

QState Level_Select(Lab2A *me) {
		switch (Q_SIG(me)) {
			case Q_ENTRY_SIG: {
				running = 0;
				counter = 0;
				game_win = 0;
				custom_tick = 0;
				return Q_HANDLED();
			}
			case CUSTOM_TIMEOUT: {
				clrScr();
				showLevel();
				return Q_HANDLED();
			}
			case ENCODER_TWIST:  {
				if (encoder_twist == 0){
				    setColor(0, 0, 0);
				    fillRect(20, 50*(lvl_no + 1) - 40, 135, 50*(lvl_no + 1) - 20);
				    setFont(SmallFont);
				    setColor(238, 64, 0);
				    snprintf(buf, sizeof(buf), "Level %d", lvl_no + 1);
				    lcdPrint(buf, 20, 50*(lvl_no + 1) - 40);

					lvl_no += 1;
					if(lvl_no == 6) lvl_no = 0;

					setColor(0, 0, 0);
				    fillRect(20, 50*(lvl_no + 1) - 40, 135, 50*(lvl_no + 1) - 20);
				    setFont(BigFont);
				    setColor(238, 64, 0);
				    snprintf(buf, sizeof(buf), "Level %d", lvl_no + 1);
				    lcdPrint(buf, 20, 50*(lvl_no + 1) - 40);

				}else if(encoder_twist == 1){
				    setColor(0, 0, 0);
				    fillRect(20, 50*(lvl_no + 1) - 40, 135, 50*(lvl_no + 1) - 20);
				    setFont(SmallFont);
				    setColor(238, 64, 0);
				    snprintf(buf, sizeof(buf), "Level %d", lvl_no + 1);
				    lcdPrint(buf, 20, 50*(lvl_no + 1) - 40);

					if(lvl_no == 0) lvl_no = 5;
					else lvl_no -= 1;

				    setColor(0, 0, 0);
				    fillRect(20, 50*(lvl_no + 1) - 40, 135, 50*(lvl_no + 1) - 20);
				    setFont(BigFont);
				    setColor(238, 64, 0);
				    snprintf(buf, sizeof(buf), "Level %d", lvl_no + 1);
				    lcdPrint(buf, 20, 50*(lvl_no + 1) - 40);
				}
				return Q_HANDLED();
			}
			case ENCODER_CLICK:  {
				initMaze(lvl_no);
				return Q_TRAN(&Pause);
			}
		}
		return Q_SUPER(&QHsm_top);
}

QState Pause(Lab2A *me) {
		switch (Q_SIG(me)) {
			case Q_ENTRY_SIG: {
				player.gridX = 0; // Start position.
			    player.gridY = 0; // Start position.
				drawPlayer();
				return Q_HANDLED();
			}
			case ENCODER_CLICK:  {
				return Q_TRAN(&Running);
			}
		}
		return Q_SUPER(&QHsm_top);
}

QState Running(Lab2A *me) {
		switch (Q_SIG(me)) {
			case Q_ENTRY_SIG: {
				counter = 0;
				running = 1;
				return Q_HANDLED();
			}
			case BUTTON: {
				if(buttonPressed == 1)	// Move North
				{
					trials = (DIR_UP - player.direction)%4;
				    // Make sure the difference is in the range 0 to 3
				    if (trials < 0) {
				    	trials += 4;
				    }
				    if(trials<2){
						for(int i=0;i<trials;i++){
							rotateClockwise();
						}

				    }else{
						for(int i=0;i<(4-trials);i++){
							rotateAntiClockwise();
						}

				    }
					moveForward(lvl_no);
				} else if(buttonPressed == 2)	// Move East
				{
					trials = (DIR_RIGHT - player.direction)%4;
				    // Make sure the difference is in the range 0 to 3
				    if (trials < 0) {
				    	trials += 4;
				    }
				    if(trials<2){
						for(int i=0;i<trials;i++){
							rotateClockwise();
						}

				    }else{
						for(int i=0;i<(4-trials);i++){
							rotateAntiClockwise();
						}

				    }
					moveForward(lvl_no);
				} else if(buttonPressed == 3) // Move South
				{
					trials = (DIR_DOWN - player.direction)%4;
				    // Make sure the difference is in the range 0 to 3
				    if (trials < 0) {
				    	trials += 4;
				    }
				    if(trials<2){
						for(int i=0;i<trials;i++){
							rotateClockwise();
						}

				    }else{
						for(int i=0;i<(4-trials);i++){
							rotateAntiClockwise();
						}

				    }
					moveForward(lvl_no);
				} else if(buttonPressed == 4) // Move West
				{
					trials = (DIR_LEFT - player.direction)%4;
				    // Make sure the difference is in the range 0 to 3
				    if (trials < 0) {
				    	trials += 4;
				    }
				    if(trials<2){
						for(int i=0;i<trials;i++){
							rotateClockwise();
						}

				    }else{
						for(int i=0;i<(4-trials);i++){
							rotateAntiClockwise();
						}

				    }
					moveForward(lvl_no);
				}

				if (player.gridX == GRID_COLS-1 && player.gridY == GRID_ROWS-2){
					game_win = 1;
					setFont(BigFont);
				    setColor(238, 64, 0);
				    lcdPrint("You Win", 40, 100);
					//lcdPrint("R U Pratyush?", 10, 100);
					return Q_TRAN(&Result);
				}else{
					return Q_HANDLED();
				}
			}
			case ENCODER_CLICK:  {
				game_win = 0;
				setFont(BigFont);
			    setColor(238, 64, 0);
			    lcdPrint("You Loose", 30, 100);
				//lcdPrint("MKB AAAG", 40, 100);
				return Q_TRAN(&Result);
			}
		}
		return Q_SUPER(&QHsm_top);
}

QState Result(Lab2A *me) {
		switch (Q_SIG(me)) {
			case Q_ENTRY_SIG: {
				running = 0;
				custom_tick = 0;
				setColor(238, 64, 0);
				setFont(BigFont);
			    lcdPrint("Game Time(s):", 20, 150);
			    setFont(SevenSegNumFont);
			    snprintf(buf, sizeof(buf), "%d", counter/1000);
			    lcdPrint(buf, 80, 175);
			}
			case CUSTOM_TIMEOUT:{
				counter = 0;
				return Q_TRAN(&Level_Select);
			}
		}
		return Q_SUPER(&QHsm_top);
}

// Game Player Logic Rules
void rotateClockwise(void) {
  // Save Current Positions
  int x = GRID_START_X + player.gridX * CELL_SIZE;	
  int y = GRID_START_Y + player.gridY * CELL_SIZE;
  setColor(34, 139, 34);  // Lime Green path color
  fillSquare(x, y, CELL_SIZE);
  setColor(0,0,0);  // Black outline
  drawSquareOutline(x, y, CELL_SIZE);

  // Rotate: UP -> RIGHT -> DOWN -> LEFT -> UP
  switch (player.direction) {
    case DIR_UP:
      player.direction = DIR_RIGHT;
      break;
    case DIR_RIGHT:
      player.direction = DIR_DOWN;
      break;
    case DIR_DOWN:
      player.direction = DIR_LEFT;
      break;
    case DIR_LEFT:
      player.direction = DIR_UP;
      break;
  }

  drawPlayer();
}

void rotateAntiClockwise(void) {
  // Clear old player
  int x = GRID_START_X + player.gridX * CELL_SIZE;
  int y = GRID_START_Y + player.gridY * CELL_SIZE;
  setColor(34, 139, 34);  // Lime Green path color
  fillSquare(x, y, CELL_SIZE);
  setColor(0,0,0);  // Black outline
  drawSquareOutline(x, y, CELL_SIZE);

  // Rotate: UP -> LEFT -> DOWN -> RIGHT -> UP
  switch (player.direction) {
    case DIR_UP:
      player.direction = DIR_LEFT;
      break;
    case DIR_LEFT:
      player.direction = DIR_DOWN;
      break;
    case DIR_DOWN:
      player.direction = DIR_RIGHT;
      break;
    case DIR_RIGHT:
      player.direction = DIR_UP;
      break;
  }

  drawPlayer();
}

void moveForward(int lvl_no) {
  int nextX, nextY;

  while (1) {
    // Calculate next position based on direction
    nextX = player.gridX;
    nextY = player.gridY;

    switch (player.direction) {
      case DIR_UP:
        nextY--;
        break;
      case DIR_DOWN:
        nextY++;
        break;
      case DIR_LEFT:
        nextX--;
        break;
      case DIR_RIGHT:
        nextX++;
        break;
    }

    // Check if next position is valid
    if (nextX < 0 || nextX >= GRID_COLS ||
        nextY < 0 || nextY >= GRID_ROWS) {
      break;  // Hit boundary
    }

    // Check if next position is a wall
    if (mazeGrid[lvl_no][nextY][nextX] == 1) {
      break;  // Hit wall
    }

    // Move to next position
    updatePlayerPosition(lvl_no, nextX, nextY);
    usleep(100000);  // Animation
  }
}

