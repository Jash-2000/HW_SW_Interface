#include "wake_word.h"
#include <math.h>
#include <stdio.h>
#include "xil_printf.h"

// =====================================================
// Memory-optimized frequency bands (8 bands instead of 16)
// Covers 0-6kHz with effective sample rate of ~12.2 kHz
// =====================================================
// Band ranges (bin indices for 256-point FFT, effective fs=12.2kHz):
// Each bin = 12200/256 ≈ 47.7 Hz
// Band 0: 100-300 Hz    (bins 2-6)    - Low freq energy
// Band 1: 300-600 Hz    (bins 6-12)   - Vowel fundamentals
// Band 2: 600-1000 Hz   (bins 12-21)  - Vowel formants
// Band 3: 1000-1500 Hz  (bins 21-31)  - Mid formants
// Band 4: 1500-2200 Hz  (bins 31-46)  - High formants
// Band 5: 2200-3200 Hz  (bins 46-67)  - Consonant energy
// Band 6: 3200-4500 Hz  (bins 67-94)  - Sibilants
// Band 7: 4500-6000 Hz  (bins 94-125) - High freq energy

static const int band_start[NUM_BANDS] = {2, 6, 12, 21, 31, 46, 67, 94};
static const int band_end[NUM_BANDS]   = {6, 12, 21, 31, 46, 67, 94, 125};

// =====================================================
// Global state (minimal memory footprint)
// =====================================================
static WakeWordTemplate g_template;
static FeatureBuffer g_buffer;
static FeatureFrame g_current_feature; // reused buffer
static FeatureFrame g_training_buffer[NUM_FRAMES];
static int g_training_count = 0;

#define DETECTION_THRESHOLD 0.70f  // Lower threshold for faster response

// =====================================================
// Implementation
// =====================================================

void wake_word_init(void)
{
    g_template.is_trained = 0;
    g_buffer.write_index = 0;
    g_buffer.frames_filled = 0;
    g_training_count = 0;
    
    // Clear buffers
    for (int i = 0; i < NUM_FRAMES; i++) {
        for (int j = 0; j < NUM_BANDS; j++) {
            g_buffer.frames[i].bands[j] = 0.0f;
            g_template.template[i].bands[j] = 0.0f;
        }
    }
}

FeatureFrame* wake_word_extract_features(const float *mag_spectrum, int n)
{
    // Extract energy in each frequency band
    for (int b = 0; b < NUM_BANDS; b++) {
        float energy = 0.0f;
        int count = 0;

        for (int k = band_start[b]; k < band_end[b] && k < n/2; k++) {
            energy += mag_spectrum[k];
            count++;
        }

        if (count > 0) {
            g_current_feature.bands[b] = energy / (float)count;
        } else {
            g_current_feature.bands[b] = 0.0f;
        }
    }
    
    // Normalize features to [0, 1]
    float max_energy = 0.0f;
    for (int b = 0; b < NUM_BANDS; b++) {
        if (g_current_feature.bands[b] > max_energy) {
            max_energy = g_current_feature.bands[b];
        }
    }
    
    if (max_energy > 0.001f) {
        for (int b = 0; b < NUM_BANDS; b++) {
            g_current_feature.bands[b] /= max_energy;
        }
    }

    return &g_current_feature;
}

// Fast dot product for similarity calculation
static float compute_similarity(const FeatureFrame *buf, const FeatureFrame *tmpl)
{
    float dot = 0.0f;
    float norm_buf = 0.0f;
    float norm_tmpl = 0.0f;
    
    for (int f = 0; f < NUM_FRAMES; f++) {
        for (int b = 0; b < NUM_BANDS; b++) {
            float v1 = buf[f].bands[b];
            float v2 = tmpl[f].bands[b];
            dot += v1 * v2;
            norm_buf += v1 * v1;
            norm_tmpl += v2 * v2;
        }
    }
    
    if (norm_buf < 0.0001f || norm_tmpl < 0.0001f) {
        return 0.0f;
    }
    
    // Cosine similarity
    return dot / (sqrtf(norm_buf) * sqrtf(norm_tmpl));
}

int wake_word_detect(FeatureFrame *frame)
{
    // Add frame to circular buffer
    g_buffer.frames[g_buffer.write_index] = *frame;
    g_buffer.write_index = (g_buffer.write_index + 1) % NUM_FRAMES;

    if (g_buffer.frames_filled < NUM_FRAMES) {
        g_buffer.frames_filled++;
        return 0; // Not enough frames yet
    }
    
    if (!g_template.is_trained) {
        return 0; // No template to compare
    }
    
    // Create properly ordered frame sequence for comparison
    FeatureFrame ordered[NUM_FRAMES];
    for (int i = 0; i < NUM_FRAMES; i++) {
        int idx = (g_buffer.write_index + i) % NUM_FRAMES;
        ordered[i] = g_buffer.frames[idx];
    }
    
    // Compute similarity
    float similarity = compute_similarity(ordered, g_template.template);

    // Detection
    return (similarity >= DETECTION_THRESHOLD) ? 1 : 0;
}

void wake_word_train_start(void)
{
    g_training_count = 0;
}

void wake_word_train_add_frame(FeatureFrame *frame)
{
    if (g_training_count < NUM_FRAMES) {
        g_training_buffer[g_training_count] = *frame;
        g_training_count++;
    }
}

int wake_word_train_finish(void)
{
    if (g_training_count != NUM_FRAMES) {
        return 0; // Training incomplete
    }
    
    // Copy training data to template
    for (int i = 0; i < NUM_FRAMES; i++) {
        g_template.template[i] = g_training_buffer[i];
    }
    
    g_template.is_trained = 1;
    return 1;
}

void wake_word_print_template(void)
{
    if (!g_template.is_trained) {
        xil_printf("No template trained yet!\n\r");
        return;
    }
    
    xil_printf("\n\r// Paste this into your code:\n\r");
    xil_printf("static const float TEMPLATE_DATA[%d][%d] = {\n\r", NUM_FRAMES, NUM_BANDS);
    
    for (int f = 0; f < NUM_FRAMES; f++) {
        xil_printf("    {");
        for (int b = 0; b < NUM_BANDS; b++) {
            // Print with 6 decimal places
            int whole = (int)g_template.template[f].bands[b];
            int frac = (int)((g_template.template[f].bands[b] - whole) * 1000000.0f);
            if (frac < 0) frac = -frac;

            xil_printf("%d.%06d", whole, frac);
            if (b < NUM_BANDS - 1) {
                xil_printf(", ");
            }
        }
        xil_printf("}");
        if (f < NUM_FRAMES - 1) {
            xil_printf(",\n\r");
        }
    }
    xil_printf("\n\r};\n\r");
    xil_printf("// Then call: wake_word_load_template(TEMPLATE_DATA);\n\r\n\r");
}

void wake_word_load_template(const float template_data[NUM_FRAMES][NUM_BANDS])
{
    for (int f = 0; f < NUM_FRAMES; f++) {
        for (int b = 0; b < NUM_BANDS; b++) {
            g_template.template[f].bands[b] = template_data[f][b];
        }
    }
    g_template.is_trained = 1;
    xil_printf("Template loaded successfully.\n\r");
}
